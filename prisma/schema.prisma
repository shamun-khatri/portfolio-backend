// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  avatar      String?
  googleId    String?      @unique
  experiences Experience[]
  educations  Education[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Bio         Bio[]
  Skill       Skill[]
}

model Experience {
  id      String   @id @default(cuid())
  img     String
  role    String
  company String
  date    String
  desc    String
  skills  String[]
  doc     String?
  userId  String
  user    User     @relation(fields: [userId], references: [id])
}

model Education {
  id     String @id @default(cuid())
  img    String
  school String
  date   String
  grade  String
  desc   String
  degree String
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  date        String?
  description String
  image       String
  tags        String[]
  category    String
  github      String?
  projectUrl  String?
  members     Member[]
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Member {
  id        String  @id @default(cuid())
  name      String
  img       String?
  linkedin  String?
  github    String?
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(cuid())
  name     String
  icon     String
  category String
  userId   String
  user     User   @relation(fields: [userId], references: [id])
}

model Bio {
  id           String   @id @default(cuid())
  name         String
  designations String[]
  desc         String
  porfileImage String
  resumeUrl    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}
